#!/usr/bin/env python3
"""mkfs.ext4 as the sandbox harness calls it, for a user who will mount the result with fuse2fs.

  * The filesystem's root must be that user's, or nothing can be written to it: `-E root_owner=<uid>:<gid>` is merged into the harness's own `-E` (or added).
  * fuse2fs reports `f_bavail` 10% below what the filesystem has free (measured on the node: a 940 MB image, 228,001 blocks free in the superblock, 205,064 reported available: the
    10% is taken off), where the kernel's ext4 reports the free blocks. The harness sizes the work disk so that `statvfs` offers the quota (`usable_image_bytes`: x 1.03 + 32 MiB) and
    refuses a D sandbox whose work disk offers less than 1.2 x S2 (`Sandbox._check_capacity`). So the WORK image (the harness's `work.img`, and only that: the trace disk's size is checked
    the other way, and its blocks count is not affected) is made 1/0.9 larger before mkfs, and `statvfs` then offers what the harness meant it to. The 10% is REAL, not only reported:
    a measured write test on a 256 MiB fuse2fs image stopped with ENOSPC at 89.0% of f_blocks = 99.9% of the f_bavail at the start (5 Nov), so the same holds for the trace disk, /tmp and /dev/shm
    images the stand-in makes: their writable space is ~10% below the size asked for (a departure recorded in every run's hpc_runtime)."""
import os
import sys

args = sys.argv[1:]
owner = f"root_owner={os.getuid()}:{os.getgid()}"
if "-E" in args and args.index("-E") + 1 < len(args):
    i = args.index("-E") + 1
    args[i] = args[i] + "," + owner
else:
    args = ["-E", owner] + args
img = args[-1]
if os.path.basename(img) == "work.img" and os.path.isfile(img):
    size = os.stat(img).st_size
    os.truncate(img, (int(size / 0.9) + 4095) // 4096 * 4096)
os.execv("/usr/sbin/mkfs.ext4", ["mkfs.ext4"] + args)
