    {
     "name": "get_file_attributes",
     "description": "Get attributes for a file id or a logical path.",
     "input_schema": {
      "additionalProperties": false,
      "properties": {
       "file_id_or_path": {
        "description": "File id or path to the file in format /<space_name>/<path_to_file>",
        "type": "string"
       },
       "attributes": {
        "anyOf": [
         {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "\n            (Optional) List of attribute names to request from Oneprovider. \n            Allowed values:\n            - Identity/location: fileId, parentFileId, index, name, conflictingName, path, type\n            - Permissions/access: activePermissionsType, posixPermissions, acl\n            - Ownership/provider/shares: ownerUserId, originProviderId, directShareIds\n            - Links: hardlinkCount, symlinkValue\n            - Display ids: displayUid, displayGid\n            - Timestamps/size: creationTime, atime, mtime, ctime, size\n            - Replication: isFullyReplicatedLocally, localReplicationRate\n            - Metadata: hasCustomMetadata, hasJsonMetadata, jsonMetadata, xattr.*\n            "
       }
      },
      "required": [
       "file_id_or_path"
      ],
      "type": "object"
     }
    },
    {
     "name": "get_file_metadata",
     "description": "Get metadata for a given file id or path by metadata types.\n\nFor many metadata values from a single request, use\nget_file_attributes with metadata-related attributes.",
