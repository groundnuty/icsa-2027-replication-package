        "default": [
         "json",
         "rdf",
         "xattrs"
        ],
        "description": "List of metadata types to get",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "file_id_or_path"
      ],
      "type": "object"
     }
    }
   ],
